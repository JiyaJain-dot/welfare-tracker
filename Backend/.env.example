PORT=4000

# Used to sign officer login tokens. Change this to any long random string.
JWT_SECRET=change_this_to_a_long_random_string

# Leave both of these blank for local development - the app will use a
# local file (data.db) automatically. Fill these in with your Turso
# database's values only when deploying to Vercel.
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# SMS_PROVIDER=console just prints messages to your terminal instead of
# actually sending SMS - perfect for development. Later, swap in a real
# provider (MSG91, Kaleyra, Twilio) inside src/utils/sms.js.
SMS_PROVIDER=console
SMS_API_KEY=
